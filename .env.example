# Опционально: нейросеть для свободных вопросов в диалоге «Спросить данные».
# Без ключа работает режим правил + логический fallback по сводке KPI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Совместимый провайдер (OpenRouter, Azure, локальный proxy и т.п.).
# Пусто = официальный OpenAI (https://api.openai.com/v1).
# OPENAI_BASE_URL=https://api.openai.com/v1
