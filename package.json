{
  "name": "sales-kpi-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "etl": "tsx scripts/etl.ts",
    "embed-db": "tsx scripts/embed-warehouse.ts",
    "verify": "tsx scripts/verify.ts && tsx scripts/verify_incentive.ts",
    "dev": "npm run etl && next dev -p 4317",
    "build": "npm run etl && npm run embed-db && next build",
    "start": "next start -p 4317",
    "lint": "eslint",
    "preview": "npm run etl && npm run embed-db && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run etl && npm run embed-db && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run etl && npm run embed-db && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@types/sql.js": "^1.4.11",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  }
}